# ═══════════════════════════════════════════════════════════════
# AERIS Health — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env file or real API keys to source control.
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
APP_NAME=AERIS Health - Pollution & Emission Risk API
ENVIRONMENT=development
SERVER_PORT=8000

# ── Database (MySQL) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pollution_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Optional: overrides the individual DB_* values above if set.
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/pollution_db

# ── Live Pollution / AQI API (WAQI — https://aqicn.org/api/) ────
# Get a free token at: https://aqicn.org/data-platform/token/
POLLUTION_API_KEY=your_waqi_api_token_here
POLLUTION_API_BASE_URL=https://api.waqi.info
POLLUTION_API_TIMEOUT_SECONDS=8

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
